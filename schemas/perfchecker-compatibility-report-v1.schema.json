{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirage-interactive-fr.github.io/PerfChecker.jl/schemas/perfchecker-compatibility-report-v1.schema.json",
  "title": "PerfChecker compatibility report v1",
  "type": "object",
  "required": ["schema_version", "suite", "profile", "checked_at", "passed", "counts", "diagnostics"],
  "properties": {
    "schema_version": {"const": "perfchecker-compatibility-report/1"},
    "suite": {"type": "string", "minLength": 1},
    "profile": {"type": "string"},
    "checked_at": {"type": "string"},
    "passed": {"type": "boolean"},
    "counts": {"type": "object"},
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["run_id", "package", "feature", "target", "status", "blocking", "blocking_packages", "message"],
        "properties": {
          "status": {"enum": ["supported", "feature_unavailable", "unsatisfiable", "unknown"]},
          "blocking": {"type": "boolean"},
          "blocking_packages": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
