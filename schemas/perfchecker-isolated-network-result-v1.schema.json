{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://juliaconstraints.github.io/PerfChecker.jl/schemas/perfchecker-isolated-network-result-v1.schema.json",
  "title": "PerfChecker isolated network result v1",
  "type": "object",
  "required": ["schema_version", "provider", "counter_provider", "command", "exit_code", "stdout", "stderr", "measurement_phase", "sample"],
  "properties": {
    "schema_version": {"const": "perfchecker-isolated-network-result/1"},
    "provider": {"enum": ["linux_netns", "wsl2_netns"]},
    "counter_provider": {"enum": ["linux-netns-nftables", "linux-netns-sysfs"]},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "exit_code": {"type": "integer"},
    "stdout": {"type": "string"},
    "stderr": {"type": "string"},
    "measurement_phase": {"const": "process_lifecycle"},
    "sample": {
      "type": "object",
      "required": ["bytes_sent", "bytes_received", "packets_sent", "packets_received", "discarded_sent", "discarded_received", "seconds", "workload_seconds", "capture_layer", "attribution_scope", "interface", "latency_context"],
      "properties": {
        "bytes_sent": {"type": "number", "minimum": 0},
        "bytes_received": {"type": "number", "minimum": 0},
        "packets_sent": {"type": "number", "minimum": 0},
        "packets_received": {"type": "number", "minimum": 0},
        "discarded_sent": {"type": "number", "minimum": 0},
        "discarded_received": {"type": "number", "minimum": 0},
        "seconds": {"type": "number", "minimum": 0},
        "workload_seconds": {"type": "number", "minimum": 0},
        "capture_layer": {"const": "isolated_interface"},
        "attribution_scope": {"const": "isolated_process_tree"},
        "interface": {"type": "string", "minLength": 1},
        "latency_context": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
