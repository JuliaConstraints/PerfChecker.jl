{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirage-interactive-fr.github.io/PerfChecker.jl/schemas/perfchecker-suite-job-v1.schema.json",
  "title": "PerfChecker suite job v1",
  "type": "object",
  "required": ["schema_version", "job_id", "suite", "profile", "status", "progress"],
  "properties": {
    "schema_version": {"const": "perfchecker-suite-job/1"},
    "job_id": {"type": "string", "format": "uuid"},
    "suite": {"type": "string"},
    "profile": {"enum": ["quick", "ci", "historical", "release"]},
    "status": {"enum": ["queued", "running", "cancelling", "cancelled", "complete", "failed"]},
    "progress": {"type": "object"},
    "result": {"type": "object"},
    "message": {"type": "string"}
  },
  "additionalProperties": false
}
