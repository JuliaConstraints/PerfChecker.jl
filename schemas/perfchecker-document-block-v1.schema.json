{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://juliaconstraints.github.io/PerfChecker.jl/schemas/perfchecker-document-block-v1.schema.json",
  "title": "PerfChecker documentation block v1",
  "type": "object",
  "required": ["schema_version", "id", "title", "views", "interactive_url", "provenance", "result"],
  "properties": {
    "schema_version": {"const": "perfchecker-document-block/1"},
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "views": {"type": "array", "items": {"enum": ["summary", "comparison", "observations", "diagnostics", "plots", "artifacts"]}},
    "interactive_url": {"type": ["string", "null"]},
    "provenance": {"type": "object"},
    "result": {"type": "object"}
  },
  "additionalProperties": false
}
