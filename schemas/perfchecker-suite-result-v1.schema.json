{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirage-interactive-fr.github.io/PerfChecker.jl/schemas/perfchecker-suite-result-v1.schema.json",
  "title": "PerfChecker suite result v1",
  "type": "object",
  "required": ["schema_version", "suite", "description", "profile", "started_at", "finished_at", "passed", "runs"],
  "properties": {
    "schema_version": {"const": "perfchecker-suite-result/1"},
    "suite": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "profile": {"enum": ["quick", "ci", "historical", "release"]},
    "started_at": {"type": "string", "minLength": 1},
    "finished_at": {"type": "string", "minLength": 1},
    "passed": {"type": "boolean"},
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["package", "feature", "workload", "version", "target_kind", "comparison_key", "status", "elapsed_seconds", "message", "summary"],
        "properties": {
          "package": {"type": "string"}, "feature": {"type": "string"},
          "workload": {"type": "string", "minLength": 1},
          "version": {"type": "string"}, "target_kind": {"enum": ["release", "dev", "candidate"]},
          "comparison_key": {"type": "string"},
          "status": {"enum": ["pass", "error", "unavailable"]},
          "elapsed_seconds": {"type": "number", "minimum": 0},
          "message": {"type": "string"}, "summary": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
